{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERA Data-centric Manuscript Framework Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "claims",
    "data_slots",
    "data_units",
    "tasks",
    "approval_B"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_text",
          "epistemic_status",
          "claim_type",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[0-9]{3,}$"
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "epistemic_status": {
            "enum": [
              "Observed",
              "Interpreted",
              "Hypothesized"
            ]
          },
          "claim_type": {
            "enum": [
              "Descriptive",
              "Comparative",
              "Associational",
              "Causal",
              "Mechanistic"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "evidence_role": {
                  "enum": [
                    "SUPPORTS_CLAIM",
                    "CONTRADICTS_CLAIM",
                    "AUDIT_TARGET",
                    "CONTEXT_ONLY"
                  ]
                }
              }
            }
          },
          "alternative_explanations": {
            "type": "array"
          },
          "limitations": {
            "type": "array"
          },
          "manuscript_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_assessment": {
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "NOT_ESTABLISHED",
              "NOT_ASSESSABLE",
              "CONTRADICTED",
              "INCONCLUSIVE"
            ]
          },
          "comparability_assessment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "data_slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_slot_id",
          "target_claim_id",
          "required_evidence_description",
          "status"
        ],
        "properties": {
          "data_slot_id": {
            "type": "string",
            "pattern": "^DS[0-9]{3,}$"
          },
          "target_claim_id": {
            "type": "string"
          },
          "required_evidence_description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "FILLED",
              "PARTIAL",
              "MISSING",
              "BLOCKED"
            ]
          },
          "available_result_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "enum": [
              "ESSENTIAL",
              "STRENGTHENING",
              "OPTIONAL"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "data_units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_unit_id",
          "source_result_ids"
        ],
        "properties": {
          "data_unit_id": {
            "type": "string",
            "pattern": "^DU[0-9]{3,}$"
          },
          "source_result_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "derived": {
            "type": "boolean"
          },
          "transformation": {
            "type": [
              "string",
              "null"
            ]
          },
          "independence_group_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "task_id",
          "task_type",
          "target_data_slot_ids",
          "expected_output",
          "completion_criteria",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^T[0-9]{3,}$"
          },
          "task_type": {
            "enum": [
              "EXPERIMENT",
              "ANALYSIS",
              "THEORY",
              "COMPUTATION",
              "LITERATURE"
            ]
          },
          "target_data_slot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "target_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          },
          "completion_criteria": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "READY",
              "BLOCKED_BY_EXPERIMENT",
              "PLANNED",
              "DONE"
            ]
          },
          "requires_experiment_before_calculation": {
            "type": "boolean"
          },
          "blocked_by_experiment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution_prerequisite_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "interpretation_prerequisite_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "publication_prerequisite_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "execution_design": {
            "type": "object",
            "properties": {
              "readiness": {
                "enum": [
                  "NOT_ASSESSED",
                  "DRAFT",
                  "BLOCKED",
                  "READY_FOR_SUPERVISOR_APPROVAL",
                  "APPROVED_FOR_EXECUTION"
                ]
              },
              "local_feasibility_status": {
                "enum": [
                  "UNASSESSED",
                  "CONFIRMED",
                  "NOT_CONFIRMED",
                  "BLOCKED",
                  "NOT_APPLICABLE"
                ]
              },
              "responsible_role": {
                "type": "string"
              },
              "decision_owner": {
                "type": "string"
              },
              "method_summary": {
                "type": "string"
              },
              "independent_variables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "controlled_variables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "response_variables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups_and_controls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "input",
                    "availability"
                  ],
                  "properties": {
                    "input": {
                      "type": "string",
                      "minLength": 1
                    },
                    "availability": {
                      "enum": [
                        "AVAILABLE",
                        "MISSING",
                        "TO_BE_CONFIRMED"
                      ]
                    },
                    "source_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "notes": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "raw_outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "qc_acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "replicate_statistics_plan": {
                "type": "string"
              },
              "uncertainty_plan": {
                "type": "string"
              },
              "safety_and_feasibility_notes": {
                "type": "string"
              },
              "decision_framework": {
                "type": "object",
                "properties": {
                  "question_type": {
                    "enum": [
                      "DIFFERENCE",
                      "ASSOCIATION",
                      "AGREEMENT",
                      "EQUIVALENCE",
                      "PREDICTION",
                      "CLASSIFICATION",
                      "MECHANISTIC_DISCRIMINATION",
                      "PROXY_VALIDATION",
                      "OTHER"
                    ]
                  },
                  "primary_estimand": {
                    "type": "string"
                  },
                  "analysis_method": {
                    "type": "string"
                  },
                  "agreement_method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "acceptance_boundary": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "acceptance_boundary_basis": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "outcome_rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "outcome",
                        "criterion",
                        "claim_implication"
                      ],
                      "properties": {
                        "outcome": {
                          "enum": [
                            "SUPPORTS",
                            "WEAKENS",
                            "CONTRADICTS",
                            "INCONCLUSIVE",
                            "MIXED"
                          ]
                        },
                        "criterion": {
                          "type": "string",
                          "minLength": 1
                        },
                        "claim_implication": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "relationship_type": {
                    "enum": [
                      "AGREEMENT",
                      "CALIBRATION",
                      "PREDICTION",
                      "CLASSIFICATION",
                      "RANKING",
                      "MONITORING",
                      "ASSOCIATION",
                      "OTHER"
                    ]
                  },
                  "relationship_other_description": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              },
              "risks_and_fallbacks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "measurement_validation": {
                "type": "object",
                "required": [
                  "validation_type",
                  "candidate_measurement",
                  "reference_measurement",
                  "sampling_design",
                  "control_coverage",
                  "accounting_closure",
                  "validation_strategy"
                ],
                "properties": {
                  "validation_type": {
                    "enum": [
                      "PROXY_TO_REFERENCE",
                      "METHOD_COMPARISON",
                      "CALIBRATION",
                      "NOT_ASSESSED",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "candidate_measurement": {
                    "type": "object",
                    "required": [
                      "name",
                      "measurand",
                      "operational_definition",
                      "method"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measurand": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operational_definition": {
                        "type": "string",
                        "minLength": 1
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "result_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "source_refs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "id"
                          ]
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "reference_measurement": {
                    "type": "object",
                    "required": [
                      "name",
                      "measurand",
                      "operational_definition",
                      "method",
                      "reference_basis",
                      "independence_rationale"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measurand": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operational_definition": {
                        "type": "string",
                        "minLength": 1
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reference_basis": {
                        "enum": [
                          "DIRECT_MEASUREMENT",
                          "REFERENCE_STANDARD",
                          "ORTHOGONAL_METHOD",
                          "COMPOSITE_REFERENCE",
                          "OTHER"
                        ]
                      },
                      "independence_rationale": {
                        "type": "string",
                        "minLength": 1
                      },
                      "limitations": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "result_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "source_refs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "id"
                          ]
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "sampling_design": {
                    "type": "object",
                    "required": [
                      "unit_of_analysis",
                      "pairing_strategy",
                      "condition_alignment"
                    ],
                    "properties": {
                      "unit_of_analysis": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pairing_strategy": {
                        "enum": [
                          "WITHIN_UNIT_PAIRED",
                          "MATCHED_UNITS",
                          "GROUP_LEVEL",
                          "UNPAIRED",
                          "UNKNOWN"
                        ]
                      },
                      "matching_factors": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "condition_alignment": {
                        "enum": [
                          "MATCHED",
                          "CONDITIONALLY_MATCHED",
                          "MISMATCHED",
                          "UNKNOWN"
                        ]
                      },
                      "unpaired_design_rationale": {
                        "type": "string"
                      },
                      "time_alignment": {
                        "type": "string"
                      },
                      "limitations": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "control_coverage": {
                    "type": "object",
                    "required": [
                      "review_status",
                      "required_control_classes",
                      "planned_controls"
                    ],
                    "properties": {
                      "review_status": {
                        "enum": [
                          "ASSESSED",
                          "PARTIALLY_ASSESSED",
                          "NOT_ASSESSED",
                          "NOT_APPLICABLE"
                        ]
                      },
                      "required_control_classes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "planned_controls": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "control_class",
                            "purpose",
                            "rationale"
                          ],
                          "properties": {
                            "control_class": {
                              "enum": [
                                "BLANK",
                                "NEGATIVE",
                                "POSITIVE",
                                "PROCESS",
                                "MATRIX",
                                "RECOVERY",
                                "SHAM",
                                "REFERENCE",
                                "VEHICLE",
                                "OTHER"
                              ]
                            },
                            "purpose": {
                              "type": "string",
                              "minLength": 1
                            },
                            "rationale": {
                              "type": "string",
                              "minLength": 1
                            },
                            "target_confounder": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": true
                        }
                      },
                      "no_control_rationale": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  },
                  "accounting_closure": {
                    "type": "object",
                    "required": [
                      "applicability"
                    ],
                    "properties": {
                      "applicability": {
                        "enum": [
                          "REQUIRED",
                          "NOT_REQUIRED",
                          "NOT_ASSESSED"
                        ]
                      },
                      "accounted_inputs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "accounted_outputs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "residual_method": {
                        "type": "string"
                      },
                      "acceptance_basis": {
                        "type": "string"
                      },
                      "rationale": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  },
                  "validation_strategy": {
                    "type": "object",
                    "required": [
                      "level"
                    ],
                    "properties": {
                      "level": {
                        "enum": [
                          "IN_SAMPLE_ONLY",
                          "INTERNAL_RESAMPLING",
                          "EXTERNAL_INDEPENDENT_DATA",
                          "PROSPECTIVE",
                          "NOT_ASSESSED"
                        ]
                      },
                      "training_data_scope": {
                        "type": "string"
                      },
                      "validation_data_scope": {
                        "type": "string"
                      },
                      "validation_dataset_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "independence_unit": {
                        "type": "string"
                      },
                      "leakage_controls": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "resampling_method": {
                        "type": "string"
                      },
                      "split_unit": {
                        "type": "string"
                      },
                      "limitations": {
                        "type": "string"
                      },
                      "planned_validation_source": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Documented source and acquisition plan for a future prospective validation dataset; do not imply the data already exist."
                      },
                      "training_dataset_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "sections": {
      "type": "object"
    },
    "figure_plan": {
      "type": "object"
    },
    "recommended_route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "introduction_outline": {
      "type": "array"
    },
    "introduction_draft": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_B": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING_HUMAN_REVIEW",
            "APPROVED",
            "DEFERRED",
            "REJECTED"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workspace_revision_number": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
