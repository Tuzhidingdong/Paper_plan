{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuzhidingdong.github.io/Paper_plan/schemas/evidence_bundle.schema.json",
  "title": "ERA Evidence Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_revision",
    "source",
    "regions",
    "panels",
    "samples",
    "result_units",
    "findings",
    "audit_records"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "workspace_revision": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "regions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/region"
      }
    },
    "panels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/panel"
      }
    },
    "samples": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sample"
      }
    },
    "result_units": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/result"
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/finding"
      }
    },
    "audit_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "visual_inspections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/inspection_history"
      }
    },
    "micro_gate": {
      "type": "object"
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "source": {
      "type": "object",
      "required": [
        "file_name",
        "sha256",
        "page_count"
      ],
      "properties": {
        "file_name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "tool_versions": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "required": [
        "region_id",
        "anchor_key",
        "page_number",
        "bbox_normalized",
        "image_path",
        "pixel_sha256"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "pattern": "^REG[0-9]{3,}$"
        },
        "anchor_key": {
          "type": "string"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "bbox_pdf": {
          "$ref": "#/$defs/bbox"
        },
        "bbox_normalized": {
          "$ref": "#/$defs/bbox"
        },
        "image_path": {
          "type": "string"
        },
        "pixel_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "perceptual_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_type": {
          "type": "string"
        },
        "triage_role": {
          "enum": [
            "REVIEW_CANDIDATE",
            "REPEATED_LAYOUT_ASSET",
            "TRIAGE_ONLY"
          ]
        },
        "extractor_version": {
          "type": "string"
        },
        "caption_separation_status": {
          "enum": [
            "UNVERIFIED",
            "CONFIRMED",
            "UNRESOLVED"
          ]
        }
      },
      "additionalProperties": true
    },
    "axis": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "enum": [
            "PENDING",
            "CONFIRMED",
            "UNRESOLVED"
          ]
        },
        "unit_status": {
          "enum": [
            "FOUND",
            "NOT_SHOWN",
            "NOT_LEGIBLE",
            "UNCERTAIN",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": true
    },
    "panel": {
      "type": "object",
      "required": [
        "panel_id",
        "parent_region_id",
        "label",
        "bbox_normalized",
        "segmentation_status"
      ],
      "properties": {
        "panel_id": {
          "type": "string",
          "pattern": "^PANEL[0-9]{3,}$"
        },
        "parent_region_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bbox_pdf": {
          "$ref": "#/$defs/bbox"
        },
        "bbox_normalized": {
          "$ref": "#/$defs/bbox"
        },
        "bbox_relative_to_parent": {
          "$ref": "#/$defs/bbox"
        },
        "image_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "pixel_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "segmentation_status": {
          "enum": [
            "SPECIFIED",
            "HUMAN_CONFIRMED",
            "UNRESOLVED"
          ]
        },
        "quantitative": {
          "type": "boolean"
        },
        "axes_review_status": {
          "enum": [
            "PENDING",
            "CONFIRMED",
            "UNRESOLVED"
          ]
        },
        "axes": {
          "type": "object",
          "properties": {
            "x": {
              "$ref": "#/$defs/axis"
            },
            "y": {
              "$ref": "#/$defs/axis"
            }
          }
        },
        "caption_separation_status": {
          "enum": [
            "UNVERIFIED",
            "CONFIRMED",
            "UNRESOLVED"
          ]
        }
      },
      "additionalProperties": true
    },
    "alias": {
      "type": "object",
      "required": [
        "alias",
        "source_ref"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sample": {
      "type": "object",
      "required": [
        "sample_id",
        "aliases",
        "identity_status"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^S[0-9]{3,}$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "prep_conditions": {
          "type": "object"
        },
        "batch_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "AMBIGUOUS",
            "UNMAPPED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": true
    },
    "sample_association": {
      "type": "object",
      "required": [
        "mapping_status"
      ],
      "properties": {
        "series_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "AMBIGUOUS",
            "UNMAPPED",
            "NOT_APPLICABLE"
          ]
        },
        "core_link": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": [
        "description",
        "source_status"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "source_status": {
          "enum": [
            "Observed",
            "Interpreted",
            "Hypothesized"
          ]
        },
        "numeric_value": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "Canonical machine-readable measurement value for this observation. A numeric string is accepted and must parse to a finite number. Qualitative descriptions and unrelated digits must not be placed here."
        },
        "numeric_values": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          },
          "description": "Machine-readable measurement values when an observation carries a transcribed series or multiple readings. Each entry must parse to a finite number. Use instead of embedding values only in description text."
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "series_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "AMBIGUOUS",
            "UNMAPPED",
            "NOT_APPLICABLE"
          ]
        },
        "data_origin": {
          "enum": [
            "Exact_Text",
            "Exact_Table",
            "Vector_Extracted",
            "Visual_Estimate",
            "Qualitative_Observation",
            "Unavailable"
          ]
        }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": [
        "result_id",
        "region_ids",
        "data_type",
        "data_origin",
        "visual_legibility",
        "quantitative_permission",
        "epistemic_status",
        "measurement_context",
        "observations"
      ],
      "properties": {
        "result_id": {
          "type": "string",
          "pattern": "^R[0-9]{3,}$"
        },
        "region_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "panel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_type": {
          "type": "string"
        },
        "data_origin": {
          "enum": [
            "Exact_Text",
            "Exact_Table",
            "Vector_Extracted",
            "Visual_Estimate",
            "Qualitative_Observation",
            "Unavailable"
          ]
        },
        "visual_legibility": {
          "enum": [
            "High",
            "Medium",
            "Low",
            "Unassessable"
          ]
        },
        "is_visual_estimate": {
          "type": "boolean"
        },
        "quantitative_permission": {
          "enum": [
            "Exact_Values",
            "Trend_Only",
            "Qualitative_Only",
            "None"
          ]
        },
        "epistemic_status": {
          "enum": [
            "Observed",
            "Interpreted",
            "Hypothesized"
          ]
        },
        "measurement_context": {
          "type": "object",
          "properties": {
            "technique": {
              "type": [
                "string",
                "null"
              ]
            },
            "measurement_conditions": {
              "type": "object"
            },
            "measurement_group": {
              "type": [
                "string",
                "null"
              ]
            },
            "sample_associations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sample_association"
              }
            }
          },
          "additionalProperties": true
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "instrument_checklist": {
          "type": "object"
        },
        "caption_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_narrative": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_audit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_role": {
          "enum": [
            "UNDECIDED",
            "CORE",
            "SUPPORTING",
            "NOT_USED"
          ]
        },
        "measurement_definition": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_ASSESSED",
                "PARTIAL",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "measurand": {
              "type": [
                "string",
                "null"
              ]
            },
            "raw_signal": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "meaning": {
                    "type": "string"
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "output_unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "normalization_basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "calibration_and_blank_corrections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uncertainty_method": {
              "type": [
                "string",
                "null"
              ]
            },
            "replicate_basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "independent_validation": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_derived_metric": {
              "type": "boolean"
            },
            "parent_result_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },

        "calculation_audits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "audit_type",
              "x_source",
              "y_source",
              "reported_source",
              "displayed_precision"
            ],
            "properties": {
              "audit_type": {
                "const": "OLS_LINEAR_FIT"
              },
              "x_source": {
                "type": "object",
                "required": ["result_id", "observation_index"],
                "properties": {
                  "result_id": {"type": "string"},
                  "observation_index": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "y_source": {
                "type": "object",
                "required": ["result_id", "observation_index"],
                "properties": {
                  "result_id": {"type": "string"},
                  "observation_index": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "reported_source": {
                "type": "object",
                "required": ["observation_index", "value_indices"],
                "properties": {
                  "result_id": {"type": "string"},
                  "observation_index": {"type": "integer", "minimum": 0},
                  "value_indices": {
                    "type": "object",
                    "required": ["slope", "intercept", "r_squared"],
                    "properties": {
                      "slope": {"type": "integer", "minimum": 0},
                      "intercept": {"type": "integer", "minimum": 0},
                      "r_squared": {"type": "integer", "minimum": 0}
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "displayed_precision": {
                "type": "object",
                "required": ["slope", "intercept", "r_squared"],
                "properties": {
                  "slope": {"type": "integer", "minimum": 0, "maximum": 12},
                  "intercept": {"type": "integer", "minimum": 0, "maximum": 12},
                  "r_squared": {"type": "integer", "minimum": 0, "maximum": 12}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "description",
        "epistemic_status",
        "supporting_result_ids",
        "alternative_explanations"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "description": {
          "type": "string"
        },
        "epistemic_status": {
          "enum": [
            "Observed",
            "Interpreted",
            "Hypothesized"
          ]
        },
        "supporting_result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictory_result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_target_result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "inspection_card": {
      "type": "object",
      "required": [
        "inspection_mode",
        "caption_text_included",
        "report_narrative_included",
        "visual_legibility",
        "data_origin",
        "quantitative_permission",
        "observations",
        "instrument_checklist"
      ],
      "properties": {
        "inspection_mode": {
          "const": "CAPTION_BLIND"
        },
        "caption_text_included": {
          "const": false
        },
        "report_narrative_included": {
          "const": false
        },
        "visual_legibility": {
          "enum": [
            "High",
            "Medium",
            "Low",
            "Unassessable"
          ]
        },
        "data_origin": {
          "enum": [
            "Exact_Text",
            "Exact_Table",
            "Vector_Extracted",
            "Visual_Estimate",
            "Qualitative_Observation",
            "Unavailable"
          ]
        },
        "quantitative_permission": {
          "enum": [
            "Exact_Values",
            "Trend_Only",
            "Qualitative_Only",
            "None"
          ]
        },
        "observations": {
          "type": "array"
        },
        "instrument_checklist": {
          "type": "object"
        },
        "recorded_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "inspection_history": {
      "type": "object",
      "required": [
        "initial",
        "reinspections",
        "locked"
      ],
      "properties": {
        "initial": {
          "oneOf": [
            {
              "$ref": "#/$defs/inspection_card"
            },
            {
              "type": "null"
            }
          ]
        },
        "reinspections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspection_card"
          },
          "maxItems": 1
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
